# Dependencies and build output
node_modules/
coverage/
dist/
*.tsbuildinfo
apps/desktop/src-tauri/target/
# Python interpreter put there by scripts/bundle-python.mjs, bundled into the installer
apps/desktop/src-tauri/resources/python/
# Schemas generated by Tauri at build time, for autocompletion in capabilities/*.json
apps/desktop/src-tauri/gen/schemas/

# Working folder of the orchestration skill (progress log, briefs, reports)
.superpowers/

# Python bytecode (tools/*.py)
__pycache__/
*.pyc

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Real documents and bank statements never enter the repository (spec section 28):
# only anonymised fixtures are allowed, and only under fixtures/.
*.xlsx
*.xls
*.csv
*.pdf
*.jpg
*.jpeg
!fixtures/**/*.xlsx
!fixtures/**/*.xls
!fixtures/**/*.csv
!fixtures/**/*.pdf
!fixtures/**/*.jpg
!fixtures/**/*.jpeg

# Virtualenv of the Python tests (python/README.md)
.venv-python/
