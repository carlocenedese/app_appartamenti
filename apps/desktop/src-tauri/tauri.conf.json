{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "App Bollette",
  "version": "0.1.0",
  "identifier": "it.bollette.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "App Bollette",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "macOS": {
      "minimumSystemVersion": "15.7"
    },
    "resources": {
      "resources/python/": "python/",
      "resources/seed-profiles/": "seed-profiles/",
      "resources/ocr-data/": "ocr-data/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
