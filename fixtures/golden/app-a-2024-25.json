  "knownDeviations": [
    {
      "what": "Commissione bancaria di 0,80 € per bolletta",
      "why": "L'Excel la somma fino ad aprile 2025 (RegistroBollette G = D*E+F); l'app conta solo le commissioni presenti nell'estratto conto (R7, R20) e per il 2024-25 non c'è estratto: commissione 0."
    },
    {
      "what": "Competenza degli avvisi TARI",
      "why": "L'Excel usa quote dell'anno solare diverse a ogni avviso; l'app assegna a ogni avviso i suoi 4 mesi nuovi (R3): terzo avviso 2024 per 3/4 nell'annualità, primo e secondo 2025 per intero, terzo 2025 per 1/4."
    },
    {
      "what": "Quota TARI di agosto 2025 scritta a mano",
      "why": "RegistroBollette G26 = 48,97 € invece della formula (12,24 €); l'app calcola dalla regola."
    },
    {
      "what": "Luce dell'inquilino C (Doppia marmo 1, ott 2024 - ago 2025)",
      "why": "Conguagli D9 somma la luce fino a giugno (RegistroBollette G17:G21) e omette luglio-agosto 2025 (G22-G23): 94,57 € nell'Excel contro 113,95 € dell'app."
    },
    {
      "what": "Importi dell'Excel per voce (campo excel)",
      "why": "Ricavati dalle formule di Conguagli D/5 per tipologia, con la commissione compresa dove l'Excel la somma; arrotondati al centesimo per voce, quindi il totale può differire di 1 centesimo da D/5 (inquilini I e K)."
    },
    {
      "what": "Spese dell'inquilino I (Doppia 1, ago-set 2025)",
      "why": "Conguagli D17 somma tutto il terzo avviso TARI 2025; l'app ne assegna solo settembre 2025."
    },
    {
      "what": "Condominio",
      "why": "Escluso da expected per costruzione (sezione 42, R3). Le rate 2024-25 non sono disponibili (l'Excel ha solo la quota annua inquilini di 2.103,34 €), quindi la fixture non ha rate di condominio e il controllo di fine esercizio del Task 9 non si applica a questa fixture. Il conguaglio condominiale 2023-24 di 1.302,68 € resta alla proprietà (user1)."
    },
    {
      "what": "Bollette della luce a cavallo di mesi parziali",
      "why": "Dal 18 novembre 2026 (decisione B2 di user1) una bolletta si divide tra i mesi in proporzione ai giorni del periodo in ciascun mese, non in parti uguali per mese: la luce degli inquilini cambia di qualche centesimo rispetto alla divisione per mesi."
    },
    {
      "what": "Forfait",
      "why": "L'Excel considera il forfait dovuto (30 € x mesi); l'app quello incassato (R4). Qui coincidono: ogni mese ha un versamento (l'inquilino I ha pagato agosto e settembre, confermato da user1)."
    },
    {
      "what": "Bolletta della luce settembre-ottobre 2025",
      "why": "Non ancora registrata: la sua metà di settembre appartiene al 2024-25 e arriverà come conguaglio supplementare (R5)."
    },
    {
      "what": "Scadenza della bolletta luce settembre-ottobre 2024",
      "why": "RegistroBollette H6 (10/11/2024) è prima dell'emissione I6 (25/11/2024): riportate come nell'Excel; la bolletta è assunta pagata e la data non cambia il conguaglio."
    },
    {
      "what": "Scadenza della bolletta luce novembre-dicembre 2024",
      "why": "RegistroBollette H8 riporta 27/01/2024, prima dell'emissione: errore di battitura, nella fixture 27/01/2025."
    }
  ]
