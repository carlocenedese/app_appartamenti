{
  "id": "profilo-sintetico",
  "v": 1,
  "rev": 1,
  "bank": "Banca Sintetica",
  "validFrom": "2020-01-01",
  "container": "csv",
  "csvSeparator": ";",
  "header": { "allOf": ["Data contabile", "Descrizione", "Importo", "Segno"] },
  "columns": {
    "date": "Data contabile",
    "description": ["Descrizione", "Causale"],
    "amount": "Importo",
    "sign": "Segno",
    "dispCode": "Codice",
    "pending": "Stato"
  },
  "dateFormat": "DD/MM/YYYY",
  "signValues": { "debit": ["D"], "credit": ["A"] },
  "pendingValues": ["Prenotato"],
  "dispCodePattern": "^[A-Z][0-9]{3}$",
  "counterparty": { "name": "da ([A-Za-z ]+)", "iban": "(IT[0-9]{2}[A-Z0-9]{23})" },
  "periodPattern": "dal ([0-9]{2}/[0-9]{2}/[0-9]{4}) al ([0-9]{2}/[0-9]{2}/[0-9]{4})",
  "accountPattern": "conto ([A-Z0-9]+)"
}
