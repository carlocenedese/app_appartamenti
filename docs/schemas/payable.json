{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "apartmentId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "registro",
        "bollo",
        "cedolare",
        "f24",
        "altro"
      ]
    },
    "dueDate": {
      "format": "date",
      "description": "Calendar date, YYYY-MM-DD. The pattern checks the month and day ranges; that the day exists in the month needs a \"format\": \"date\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "expected": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "repeatYearly": {
      "type": "boolean",
      "const": true
    },
    "previousId": {
      "type": "string",
      "minLength": 1
    },
    "paid": {
      "type": "object",
      "properties": {
        "date": {
          "format": "date",
          "description": "Calendar date, YYYY-MM-DD. The pattern checks the month and day ranges; that the day exists in the month needs a \"format\": \"date\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "transactionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "date"
      ]
    },
    "taxYear": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "taxVoice": {
      "type": "string",
      "enum": [
        "cedolare",
        "registro"
      ]
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "apartmentId",
    "kind",
    "dueDate"
  ],
  "description": "id starts with scad-; expected is positive cents; taxYear 1-9999; taxVoice only for bollo, f24 and altro."
}
