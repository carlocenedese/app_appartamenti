{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "itemType": {
      "type": "string",
      "enum": [
        "bill",
        "instalment"
      ]
    },
    "itemId": {
      "type": "string",
      "minLength": 1
    },
    "transactionId": {
      "type": "string",
      "minLength": 1
    },
    "transactionDate": {
      "format": "date",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "amount": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "part": {
      "type": "string",
      "enum": [
        "amount",
        "commission"
      ]
    },
    "confirmed": {
      "type": "boolean"
    },
    "by": {
      "type": "string",
      "enum": [
        "auto",
        "manual",
        "assumed"
      ]
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "itemType",
    "itemId",
    "transactionId",
    "transactionDate",
    "amount",
    "part",
    "confirmed",
    "by"
  ]
}
