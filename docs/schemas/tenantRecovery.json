{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "apartmentId": {
      "type": "string",
      "minLength": 1
    },
    "instalmentId": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "shares": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "tenantId",
          "amount"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "da-recuperare",
        "recuperata",
        "non-recuperabile"
      ]
    },
    "periodLabel": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "apartmentId",
    "instalmentId",
    "amount",
    "shares",
    "status"
  ],
  "description": "amount and shares are positive cents; each tenant once; the shares add up to amount."
}
