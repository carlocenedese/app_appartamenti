{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "apartmentId": {
      "type": "string",
      "minLength": 1
    },
    "periodLabel": {
      "type": "string",
      "minLength": 1
    },
    "from": {
      "description": "Calendar month, YYYY-MM (01 to 12). Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
    },
    "to": {
      "description": "Calendar month, YYYY-MM (01 to 12). Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
    },
    "closedAt": {
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp ending in Z, e.g. 2026-11-10T20:15:00.000Z. That the day exists in the month needs a \"format\": \"date-time\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "engineVersion": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "tenants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tenantId": {
                "type": "string",
                "minLength": 1
              },
              "spese": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "rata": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "commissione": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "tenantId",
              "spese",
              "rata",
              "commissione"
            ]
          }
        },
        "emptyBeds": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "tenants",
        "emptyBeds"
      ]
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "apartmentId",
    "periodLabel",
    "from",
    "to",
    "closedAt",
    "engineVersion",
    "snapshot"
  ],
  "description": "id is chiusura-<apartmentId>-<periodLabel>; amounts in cents."
}
