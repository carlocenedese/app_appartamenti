{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "locatore": {
      "type": "string",
      "minLength": 1
    },
    "posti": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "earlierBeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "to": {
            "description": "Calendar month, YYYY-MM (01 to 12). Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
            "type": "string",
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
          },
          "posti": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "rooms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "to",
          "posti"
        ]
      }
    },
    "contrattoMensile": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "annualitaStart": {
      "type": "object",
      "properties": {
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      },
      "required": [
        "month",
        "day"
      ],
      "description": "A month and day that exist every year; day must exist in that month."
    },
    "condominioStart": {
      "type": "object",
      "properties": {
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      },
      "required": [
        "month",
        "day"
      ],
      "description": "A month and day that exist every year; day must exist in that month."
    },
    "condoDifferenceTo": {
      "type": "string",
      "enum": [
        "tenants",
        "owner"
      ]
    },
    "rentLateDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31
    },
    "address": {
      "type": "string",
      "minLength": 1
    },
    "supplyCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cadastre": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sheet": {
            "type": "string",
            "minLength": 1
          },
          "parcel": {
            "type": "string",
            "minLength": 1
          },
          "sub": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sheet",
          "parcel",
          "sub"
        ]
      }
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "name",
    "locatore",
    "posti",
    "annualitaStart"
  ],
  "description": "When rooms is present: one unique name per bed (posti). earlierBeds: increasing months, the same rule for each entry."
}
