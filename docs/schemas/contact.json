{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "role": {
      "type": "string",
      "enum": [
        "amministratore",
        "fornitore"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "phone": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "apartmentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supplyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "elettricita",
          "gas",
          "acqua",
          "internet",
          "altro"
        ]
      }
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "role",
    "name",
    "apartmentIds"
  ],
  "description": "Each apartment, supply and category appears once."
}
