{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "year": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "rateBp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "year",
    "rateBp"
  ],
  "description": "id is tasso-<year>; rateBp in basis points, 0 to 10000."
}
