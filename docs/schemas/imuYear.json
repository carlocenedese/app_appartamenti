{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "apartmentId": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "f24Group": {
      "type": "string",
      "minLength": 1
    },
    "annualTotal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rates": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "expected": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "dueDate": {
            "format": "date",
            "description": "Calendar date, YYYY-MM-DD. The pattern checks the month and day ranges; that the day exists in the month needs a \"format\": \"date\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
            "type": "string",
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
          }
        },
        "required": [
          "index"
        ]
      }
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "apartmentId",
    "year",
    "f24Group",
    "rates"
  ],
  "description": "id is imu-<apartmentId>-<year>; rates[i].index is i + 1; amounts are positive cents."
}
