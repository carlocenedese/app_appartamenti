{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "supplier": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "bill",
        "tari"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "elettricita",
        "gas",
        "acqua",
        "internet",
        "altro"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "bozza",
        "confermato"
      ]
    },
    "autoRegister": {
      "type": "boolean"
    },
    "validFrom": {
      "format": "date",
      "description": "Calendar date, YYYY-MM-DD. The pattern checks the month and day ranges; that the day exists in the month needs a \"format\": \"date\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "validTo": {
      "format": "date",
      "description": "Calendar date, YYYY-MM-DD. The pattern checks the month and day ranges; that the day exists in the month needs a \"format\": \"date\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "recognise": {
      "type": "object",
      "properties": {
        "allOf": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "noneOf": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ocrAnyOf": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "allOf",
        "noneOf"
      ]
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "number",
          "issueDate",
          "dueDate",
          "period",
          "amount",
          "consumption"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "required": {
            "type": "boolean"
          },
          "rules": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "anchor": {
                  "type": "string",
                  "minLength": 1
                },
                "position": {
                  "type": "string",
                  "enum": [
                    "same-line",
                    "right",
                    "below"
                  ]
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Regular expression valid in JavaScript and Python: numbered groups only, no lookbehind (\"(?<=\", \"(?<!\"), no inline flags such as \"(?i)\"."
                },
                "valueType": {
                  "type": "string",
                  "enum": [
                    "euro",
                    "date",
                    "date-range",
                    "text",
                    "quantity"
                  ]
                },
                "group": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "anchor",
                "position",
                "pattern",
                "valueType"
              ]
            }
          },
          "combine": {
            "type": "string",
            "enum": [
              "span"
            ]
          }
        },
        "required": [
          "required",
          "rules"
        ]
      }
    },
    "identifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "pod",
              "pdr",
              "customer"
            ]
          },
          "pattern": {
            "type": "string",
            "minLength": 1,
            "description": "Regular expression valid in JavaScript and Python: numbered groups only, no lookbehind (\"(?<=\", \"(?<!\"), no inline flags such as \"(?i)\"."
          }
        },
        "required": [
          "kind",
          "pattern"
        ]
      }
    },
    "parts": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "Regular expression valid in JavaScript and Python: numbered groups only, no lookbehind (\"(?<=\", \"(?<!\"), no inline flags such as \"(?i)\"."
        },
        "add": {
          "type": "string",
          "minLength": 1,
          "description": "Regular expression valid in JavaScript and Python: numbered groups only, no lookbehind (\"(?<=\", \"(?<!\"), no inline flags such as \"(?i)\"."
        },
        "property": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1,
              "description": "Regular expression valid in JavaScript and Python: numbered groups only, no lookbehind (\"(?<=\", \"(?<!\"), no inline flags such as \"(?i)\"."
            }
          },
          "required": [
            "pattern"
          ]
        }
      },
      "required": [
        "pattern"
      ]
    },
    "items": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "Regular expression valid in JavaScript and Python: numbered groups only, no lookbehind (\"(?<=\", \"(?<!\"), no inline flags such as \"(?i)\"."
        }
      },
      "required": [
        "pattern"
      ]
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "supplier",
    "kind",
    "status",
    "autoRegister",
    "validFrom",
    "recognise",
    "fields",
    "identifiers"
  ],
  "description": "kind \"bill\" needs a category and kind \"tari\" must not have one; parts only with kind \"tari\"; validFrom must not be after validTo; the valueType of every rule of a field is fixed: amount euro, issueDate and dueDate date, period date-range, consumption quantity, number text; the group of every rule must be one of its pattern's capture groups (0 is the whole match), the parts pattern needs at least 2 capture groups and the items pattern at least 1; combine \"span\" only on the period."
}
