{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "apartmentId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "condominio",
        "tari"
      ]
    },
    "esercizio": {
      "type": "string",
      "minLength": 1
    },
    "rateIndex": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rateCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "enum": [
        1,
        2,
        3,
        4,
        6,
        12
      ]
    },
    "dueDate": {
      "format": "date",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rata": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "quotaProprieta": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "conguaglioPrec": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "straordinaria": {
      "type": "boolean"
    },
    "paidFromApartmentId": {
      "type": "string"
    },
    "shared": {
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "groupTotal": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "weight": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "groupId",
        "groupTotal",
        "weight"
      ]
    },
    "coversFrom": {
      "description": "Calendar month, YYYY-MM (month 01 to 12)",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "coversTo": {
      "description": "Calendar month, YYYY-MM (month 01 to 12)",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "fileHash": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "apartmentId",
    "kind",
    "esercizio",
    "rateIndex",
    "rateCount",
    "dueDate",
    "rata",
    "quotaProprieta",
    "conguaglioPrec",
    "coversFrom",
    "coversTo"
  ],
  "description": "rateIndex must not exceed rateCount; coversFrom must not be after coversTo."
}
