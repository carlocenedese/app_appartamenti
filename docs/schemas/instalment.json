{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "apartmentId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "condominio",
        "tari"
      ]
    },
    "esercizio": {
      "type": "string",
      "minLength": 1
    },
    "rateIndex": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rateCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "enum": [
        1,
        2,
        3,
        4,
        6,
        12
      ]
    },
    "dueDate": {
      "format": "date",
      "description": "Calendar date, YYYY-MM-DD. The pattern checks the month and day ranges; that the day exists in the month needs a \"format\": \"date\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "issueDate": {
      "format": "date",
      "description": "Calendar date, YYYY-MM-DD. The pattern checks the month and day ranges; that the day exists in the month needs a \"format\": \"date\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "rata": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "quotaProprieta": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "conguaglioPrec": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "straordinaria": {
      "type": "boolean"
    },
    "paidFromApartmentId": {
      "type": "string",
      "minLength": 1
    },
    "supplyId": {
      "type": "string",
      "minLength": 1
    },
    "shared": {
      "type": "object",
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "groupTotal": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "weight": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "groupId",
        "groupTotal",
        "weight"
      ]
    },
    "coversFrom": {
      "description": "Calendar month, YYYY-MM (01 to 12). Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
    },
    "coversTo": {
      "description": "Calendar month, YYYY-MM (01 to 12). Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
    },
    "fileHash": {
      "type": "string",
      "minLength": 1
    },
    "fileDocument": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "documentKind": {
          "type": "string",
          "enum": [
            "bill",
            "tari",
            "unknown"
          ]
        }
      },
      "required": [
        "pages",
        "documentKind"
      ],
      "description": "pages[0] must not be after pages[1]."
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "apartmentId",
    "kind",
    "esercizio",
    "rateIndex",
    "rateCount",
    "dueDate",
    "rata",
    "quotaProprieta",
    "conguaglioPrec",
    "coversFrom",
    "coversTo"
  ],
  "description": "rateIndex must not exceed rateCount; coversFrom must not be after coversTo."
}
