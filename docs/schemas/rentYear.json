{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "apartmentId": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "totalRent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "apartmentId",
    "year",
    "totalRent"
  ],
  "description": "id is rent-<apartmentId>-<year>; totalRent is positive cents."
}
