{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "apartmentId": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "voce": {
      "type": "string",
      "enum": [
        "cedolare",
        "imu",
        "registro",
        "tari",
        "condominio"
      ]
    },
    "difference": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "annualDifference": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "apartmentId",
    "year",
    "voce",
    "difference",
    "note"
  ],
  "description": "id is taxc-<apartmentId>-<year>-<voce>; note not empty."
}
