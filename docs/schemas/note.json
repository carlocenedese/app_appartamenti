{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "targetType": {
      "type": "string",
      "enum": [
        "apartment",
        "contract",
        "tenancy",
        "bill",
        "instalment",
        "payment",
        "transaction",
        "match"
      ]
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp ending in Z, e.g. 2026-11-10T20:15:00.000Z. That the day exists in the month needs a \"format\": \"date-time\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "visibleToTenants": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "targetType",
    "targetId",
    "text",
    "profileId",
    "at"
  ]
}
