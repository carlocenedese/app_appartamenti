{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "apartmentId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "format": "date",
      "description": "Calendar date, YYYY-MM-DD. The pattern checks the month and day ranges; that the day exists in the month needs a \"format\": \"date\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "amount": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "confirmed": {
      "type": "boolean"
    },
    "kind": {
      "type": "string",
      "enum": [
        "canone",
        "conguaglio",
        "caparra",
        "altro"
      ]
    },
    "forMonth": {
      "description": "Calendar month, YYYY-MM (01 to 12). Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
    },
    "source": {
      "type": "string",
      "enum": [
        "csv",
        "manual",
        "excel"
      ]
    },
    "transactionId": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "apartmentId",
    "tenantId",
    "date",
    "amount",
    "confirmed",
    "kind",
    "source"
  ]
}
