{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "apartmentId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "format": "date",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "amount": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "confirmed": {
      "type": "boolean"
    },
    "kind": {
      "type": "string",
      "enum": [
        "canone",
        "conguaglio",
        "caparra",
        "altro"
      ]
    },
    "forMonth": {
      "description": "Calendar month, YYYY-MM (month 01 to 12)",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "source": {
      "type": "string",
      "enum": [
        "csv",
        "manual",
        "excel"
      ]
    },
    "transactionId": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "apartmentId",
    "tenantId",
    "date",
    "amount",
    "confirmed",
    "kind",
    "source"
  ]
}
