{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "transactionId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "escluso",
        "utenze",
        "tasse",
        "condominio",
        "altro"
      ]
    },
    "excludeReason": {
      "type": "string",
      "enum": [
        "doppione",
        "non-contabilizzato",
        "non-reale",
        "privato"
      ]
    },
    "apartmentId": {
      "type": "string",
      "minLength": 1
    },
    "f24": {
      "type": "boolean",
      "const": true
    },
    "ruleId": {
      "type": "string",
      "minLength": 1
    },
    "imu": {
      "type": "object",
      "properties": {
        "f24Group": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "rateIndex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "f24Group",
        "year",
        "rateIndex"
      ]
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "transactionId",
    "kind"
  ],
  "description": "id is mc-<transactionId>. excludeReason is present if and only if kind is escluso; apartmentId if and only if kind is not escluso; f24 only with tasse; ruleId never with escluso; imu only with f24."
}
