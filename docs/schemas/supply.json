{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "apartments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "apartmentId": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "apartmentId",
          "weight"
        ]
      }
    },
    "earlierApartments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "to": {
            "description": "Calendar month, YYYY-MM (01 to 12). Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
            "type": "string",
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
          },
          "apartments": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "apartmentId": {
                  "type": "string",
                  "minLength": 1
                },
                "weight": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              },
              "required": [
                "apartmentId",
                "weight"
              ]
            }
          }
        },
        "required": [
          "to",
          "apartments"
        ]
      }
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "label",
    "apartments"
  ],
  "description": "apartments: at least one, each apartment once, weight in basis points (1..10000), sum exactly 10000. earlierApartments: increasing months, the same rules for each entry."
}
