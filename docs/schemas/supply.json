{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "apartments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "apartmentId": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "apartmentId",
          "weight"
        ]
      }
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "label",
    "apartments"
  ],
  "description": "apartments: at least one, each apartment once, weight a whole number >= 1."
}
