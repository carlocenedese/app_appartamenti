{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "apartmentId": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "format": "date",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "amount": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "description": {
      "type": "string"
    },
    "dispCode": {
      "type": "string"
    },
    "statementHash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "apartmentId",
    "date",
    "amount",
    "description",
    "statementHash"
  ]
}
