{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "accountId": {
      "type": "string",
      "minLength": 1
    },
    "bankProfileId": {
      "type": "string",
      "minLength": 1
    },
    "fileName": {
      "type": "string",
      "minLength": 1
    },
    "suggestedPath": {
      "type": "string",
      "minLength": 1
    },
    "from": {
      "format": "date",
      "description": "Calendar date, YYYY-MM-DD. The pattern checks the month and day ranges; that the day exists in the month needs a \"format\": \"date\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "to": {
      "format": "date",
      "description": "Calendar date, YYYY-MM-DD. The pattern checks the month and day ranges; that the day exists in the month needs a \"format\": \"date\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "periodSource": {
      "type": "string",
      "enum": [
        "file",
        "manual"
      ]
    },
    "rowCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "transactionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "held": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "enum": [
              "possible-duplicate",
              "pending"
            ]
          },
          "transaction": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "v": {
                "type": "number",
                "const": 1
              },
              "rev": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "deleted": {
                "type": "boolean"
              },
              "apartmentId": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "format": "date",
                "description": "Calendar date, YYYY-MM-DD. The pattern checks the month and day ranges; that the day exists in the month needs a \"format\": \"date\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
                "type": "string",
                "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
              },
              "amount": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "description": {
                "type": "string"
              },
              "dispCode": {
                "type": "string"
              },
              "statementHash": {
                "type": "string",
                "minLength": 1
              },
              "accountId": {
                "type": "string",
                "minLength": 1
              },
              "counterparty": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "iban": {
                    "type": "string"
                  }
                }
              },
              "booked": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "v",
              "rev",
              "apartmentId",
              "date",
              "amount",
              "description",
              "statementHash"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "keep",
              "exclude"
            ]
          }
        },
        "required": [
          "row",
          "reason",
          "transaction"
        ]
      }
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "accountId",
    "bankProfileId",
    "fileName",
    "suggestedPath",
    "from",
    "to",
    "periodSource",
    "rowCount",
    "transactionIds",
    "held"
  ],
  "description": "from must not be after to. The id is the fingerprint of the file."
}
