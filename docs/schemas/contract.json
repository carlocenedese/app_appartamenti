{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "rev": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "boolean"
    },
    "apartmentId": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "1+1",
        "3+2",
        "4+4",
        "altro"
      ]
    },
    "start": {
      "description": "Calendar month, YYYY-MM (01 to 12). Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
    },
    "end": {
      "description": "Calendar month, YYYY-MM (01 to 12). Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
    },
    "settlement": {
      "type": "string",
      "enum": [
        "annuale",
        "intero-contratto"
      ]
    },
    "agreedRent": {
      "type": "boolean",
      "const": true
    },
    "forStudents": {
      "type": "boolean",
      "const": true
    },
    "durationMonths": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "signedOn": {
      "format": "date",
      "description": "Calendar date, YYYY-MM-DD. The pattern checks the month and day ranges; that the day exists in the month needs a \"format\": \"date\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "registration": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "format": "date",
          "description": "Calendar date, YYYY-MM-DD. The pattern checks the month and day ranges; that the day exists in the month needs a \"format\": \"date\" check or the consumer's own. Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
          "type": "string",
          "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
        }
      }
    },
    "taxRegime": {
      "type": "string",
      "enum": [
        "cedolare",
        "ordinario"
      ]
    },
    "cedolareRateBp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "tenancyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "depositPaymentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rent": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "description": "Calendar month, YYYY-MM (01 to 12). Where \"$\" accepts a trailing newline (Python), the consumer must reject one.",
            "type": "string",
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
          },
          "monthlyRent": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "monthlyAdvance": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "from",
          "monthlyRent",
          "monthlyAdvance"
        ]
      }
    }
  },
  "required": [
    "id",
    "v",
    "rev",
    "apartmentId",
    "type",
    "start",
    "end",
    "settlement"
  ],
  "description": "start must not be after end. cedolareRateBp only with taxRegime cedolare. tenancyIds and depositPaymentIds without repetitions. rent: from strictly increasing, each between start and end, monthlyRent > 0, monthlyAdvance >= 0."
}
