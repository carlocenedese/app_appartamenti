      "type": "object",
      "properties": {
        "consumption": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unitPrice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
