{
  "name": "app-bollette",
  "version": "0.1.0",
  "private": true,
  "description": "App per la gestione delle bollette degli appartamenti in affitto",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --coverage",
    "licenses:check": "node scripts/check-licenses.mjs",
    "data:check": "node scripts/check-personal-data.mjs",
    "tools:test": "python3 -I -m unittest discover -s tools -p 'test_*.py'",
    "python:test": "node scripts/python.mjs -I -m unittest discover -s python/tests",
    "python:licenses": "node scripts/python.mjs -I python/tools/check_licenses.py",
    "python:dev-install": "node scripts/python.mjs -I python/tools/dev_install.py",
    "schemas:export": "tsx scripts/export-schemas.mjs",
    "golden:report": "tsx scripts/golden-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
}
